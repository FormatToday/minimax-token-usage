{
  "name": "minimax-token-usage",
  "version": "1.0.0",
  "description": "桌面置顶小工具：查询 MiniMax Token Plan (Coding Plan) 使用量",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FormatToday/minimax-token-usage.git"
  },
  "bugs": {
    "url": "https://github.com/FormatToday/minimax-token-usage/issues"
  },
  "homepage": "https://github.com/FormatToday/minimax-token-usage",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "build": "vite build",
    "start": "electron .",
    "package": "vite build && electron-builder",
    "package:win": "vite build && electron-builder --win",
    "package:win:clean": "node scripts/clean-builder-cache.js && vite build && electron-builder --win",
    "package:mac": "vite build && electron-builder --mac",
    "clean:builder-cache": "node scripts/clean-builder-cache.js",
    "postinstall": "node scripts/fix-electron-path.js"
  },
  "build": {
    "appId": "com.zhangqin.minimax-token-usage",
    "productName": "MiniMax Token Usage",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "keywords": [
    "minimax",
    "coding-plan",
    "token-plan",
    "electron",
    "vue"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "vue": "^3.5.13"
  }
}
